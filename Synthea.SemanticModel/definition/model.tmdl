model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-CA
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Encounter","Patient","Condition","Observation","ObservationComponent","Immunization","DiagnosticReport"]

annotation PBI_ProTooling = ["DevMode"]

ref table Encounter
ref table Patient
ref table Condition
ref table Observation
ref table ObservationComponent
ref table Immunization
ref table DiagnosticReport

ref cultureInfo en-US

